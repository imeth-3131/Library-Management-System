@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold">Library Management System</h1>
        <p class="text-muted">
            Welcome to your library dashboard
        </p>
    </div>

    <!-- Statistics -->
    <div class="row g-4">

        <!-- Total Books -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Total Books
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.TotalBooks
                    </h2>

                    <a asp-controller="Books"
                       asp-action="Index"
                       class="btn btn-primary btn-sm">
                        Manage Books
                    </a>
                </div>
            </div>
        </div>

        <!-- Available Books -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Available Copies
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.AvailableBooks
                    </h2>

                    <a asp-controller="Books"
                       asp-action="Index"
                       class="btn btn-success btn-sm">
                        View Books
                    </a>
                </div>
            </div>
        </div>

        <!-- Members -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Total Members
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.TotalMembers
                    </h2>

                    <a asp-controller="Members"
                       asp-action="Index"
                       class="btn btn-info btn-sm text-white">
                        Manage Members
                    </a>
                </div>
            </div>
        </div>

        <!-- Borrowed -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Currently Borrowed
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.CurrentlyBorrowed
                    </h2>

                    <a asp-controller="Borrowings"
                       asp-action="Index"
                       class="btn btn-warning btn-sm">
                        View Borrowings
                    </a>
                </div>
            </div>
        </div>

        <!-- Returned -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Returned Books
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.ReturnedBooks
                    </h2>

                    <a asp-controller="Borrowings"
                       asp-action="Index"
                       class="btn btn-success btn-sm">
                        View History
                    </a>
                </div>
            </div>
        </div>

        <!-- Overdue -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Overdue Books
                    </h6>

                    <h2 class="fw-bold text-danger">
                        @ViewBag.OverdueBooks
                    </h2>

                    <a asp-controller="Borrowings"
                       asp-action="Index"
                       class="btn btn-danger btn-sm">
                        View Overdue
                    </a>
                </div>
            </div>
        </div>

    </div>

    <!-- Quick Actions -->
    <div class="card shadow-sm border-0 mt-5">

        <div class="card-body">

            <h4 class="mb-4">
                Quick Actions
            </h4>

            <div class="d-flex gap-2 flex-wrap">

                <a asp-controller="Books"
                   asp-action="Create"
                   class="btn btn-primary">
                    + Add Book
                </a>

                <a asp-controller="Members"
                   asp-action="Create"
                   class="btn btn-info text-white">
                    + Add Member
                </a>

                <a asp-controller="Borrowings"
                   asp-action="Create"
                   class="btn btn-success">
                    + Borrow Book
                </a>

                <a asp-controller="Borrowings"
                   asp-action="Index"
                   class="btn btn-secondary">
                    View All Borrowings
                </a>

            </div>

        </div>

    </div>

</div>